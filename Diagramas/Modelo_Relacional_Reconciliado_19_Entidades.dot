digraph G {
graph [rankdir=LR, bgcolor="white", nodesep=0.35, ranksep=0.8, fontname="Arial", pad=0.25];
node [fontname="Arial", fontsize=12, color="black"];
edge [fontname="Arial", fontsize=10, color="black"];
ROL [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>ROL</B></TD></TR><TR><TD ALIGN="LEFT">ID_ROL</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">NOMBRE</TD><TD ALIGN="LEFT">VARCHAR2(30)</TD><TD>UQ NN</TD></TR></TABLE>>];
USUARIO [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>USUARIO</B></TD></TR><TR><TD ALIGN="LEFT">ID_USUARIO</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_ROL</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">NOMBRE</TD><TD ALIGN="LEFT">VARCHAR2(100)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">CORREO</TD><TD ALIGN="LEFT">VARCHAR2(120)</TD><TD>UQ NN</TD></TR><TR><TD ALIGN="LEFT">CLAVE_HASH</TD><TD ALIGN="LEFT">VARCHAR2(255)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ESTADO</TD><TD ALIGN="LEFT">VARCHAR2(15)</TD><TD>NN</TD></TR></TABLE>>];
HOGAR [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>HOGAR</B></TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">CODIGO_OPERATIVO</TD><TD ALIGN="LEFT">VARCHAR2(30)</TD><TD>UQ NN</TD></TR><TR><TD ALIGN="LEFT">REGION</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">DEPARTAMENTO</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">MUNICIPIO</TD><TD ALIGN="LEFT">VARCHAR2(8)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">CLASE</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">SECTOR</TD><TD ALIGN="LEFT">VARCHAR2(8)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">SECCION</TD><TD ALIGN="LEFT">VARCHAR2(8)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">MANZANA</TD><TD ALIGN="LEFT">VARCHAR2(8)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">SEGMENTO</TD><TD ALIGN="LEFT">VARCHAR2(8)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">CICLO</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">EDIFICACION_NUMERO</TD><TD ALIGN="LEFT">VARCHAR2(8)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">VIVIENDA_NUMERO</TD><TD ALIGN="LEFT">VARCHAR2(8)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">TOTAL_HOGARES_VIVIENDA</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">TOTAL_PERSONAS</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">BARRIO_VEREDA</TD><TD ALIGN="LEFT">VARCHAR2(120)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">DIRECCION</TD><TD ALIGN="LEFT">VARCHAR2(180)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">TELEFONO</TD><TD ALIGN="LEFT">VARCHAR2(30)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">RESULTADO</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ESTADO</TD><TD ALIGN="LEFT">VARCHAR2(20)</TD><TD>NN</TD></TR></TABLE>>];
ASIGNACION_HOGAR [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>ASIGNACION_HOGAR</B></TD></TR><TR><TD ALIGN="LEFT">ID_ASIGNACION</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_USUARIO</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">FECHA_ASIGNACION</TD><TD ALIGN="LEFT">DATE</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ESTADO</TD><TD ALIGN="LEFT">VARCHAR2(15)</TD><TD>NN</TD></TR></TABLE>>];
PERIODO_RECOLECCION [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>PERIODO_RECOLECCION</B></TD></TR><TR><TD ALIGN="LEFT">ID_PERIODO</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK UQ NN</TD></TR><TR><TD ALIGN="LEFT">FECHA_INICIO</TD><TD ALIGN="LEFT">DATE</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FECHA_FIN</TD><TD ALIGN="LEFT">DATE</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ESTADO</TD><TD ALIGN="LEFT">VARCHAR2(15)</TD><TD>NN</TD></TR></TABLE>>];
VISITA [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>VISITA</B></TD></TR><TR><TD ALIGN="LEFT">ID_VISITA</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">NUMERO_VISITA</TD><TD ALIGN="LEFT">NUMBER(2,0)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FECHA</TD><TD ALIGN="LEFT">DATE</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">HORA_INICIO</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT">HORA_FIN</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT">RESULTADO_ENTREVISTA</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">PENDIENTES</TD><TD ALIGN="LEFT">VARCHAR2(300)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">PROXIMA_FECHA</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR><TR><TD ALIGN="LEFT">PROXIMA_HORA</TD><TD ALIGN="LEFT">DATE</TD><TD></TD></TR></TABLE>>];
GRUPO_ALIMENTO [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>GRUPO_ALIMENTO</B></TD></TR><TR><TD ALIGN="LEFT">ID_GRUPO</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">CODIGO</TD><TD ALIGN="LEFT">VARCHAR2(3)</TD><TD>UQ NN</TD></TR><TR><TD ALIGN="LEFT">NOMBRE</TD><TD ALIGN="LEFT">VARCHAR2(180)</TD><TD>NN</TD></TR></TABLE>>];
FRECUENCIA_COMPRA [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>FRECUENCIA_COMPRA</B></TD></TR><TR><TD ALIGN="LEFT">ID_FRECUENCIA</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">CODIGO</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD>UQ NN</TD></TR><TR><TD ALIGN="LEFT">NOMBRE</TD><TD ALIGN="LEFT">VARCHAR2(40)</TD><TD>NN</TD></TR></TABLE>>];
CARACTERISTICA_GASTO [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>CARACTERISTICA_GASTO</B></TD></TR><TR><TD ALIGN="LEFT">ID_CARACTERISTICA</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">ID_GRUPO</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">ID_FRECUENCIA</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">VALOR_ULTIMA_COMPRA</TD><TD ALIGN="LEFT">NUMBER(14,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">COMPRARA_14_DIAS</TD><TD ALIGN="LEFT">NUMBER(1,0)</TD><TD></TD></TR></TABLE>>];
RESUMEN_MERCADO [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>RESUMEN_MERCADO</B></TD></TR><TR><TD ALIGN="LEFT">ID_RESUMEN</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">CODIGO_MERCADO</TD><TD ALIGN="LEFT">VARCHAR2(3)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">VALOR_TOTAL</TD><TD ALIGN="LEFT">NUMBER(14,2)</TD><TD>NN</TD></TR></TABLE>>];
JORNADA_DIARIA [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>JORNADA_DIARIA</B></TD></TR><TR><TD ALIGN="LEFT">ID_JORNADA</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">DIA_ENCUESTA</TD><TD ALIGN="LEFT">NUMBER(2,0)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FECHA</TD><TD ALIGN="LEFT">DATE</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">TOTAL_RENGLONES</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">OBSERVACIONES</TD><TD ALIGN="LEFT">VARCHAR2(500)</TD><TD></TD></TR></TABLE>>];
UNIDAD_MEDIDA [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>UNIDAD_MEDIDA</B></TD></TR><TR><TD ALIGN="LEFT">ID_UNIDAD</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">CODIGO</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD>UQ NN</TD></TR><TR><TD ALIGN="LEFT">NOMBRE</TD><TD ALIGN="LEFT">VARCHAR2(60)</TD><TD>NN</TD></TR></TABLE>>];
FORMA_ADQUISICION [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>FORMA_ADQUISICION</B></TD></TR><TR><TD ALIGN="LEFT">ID_FORMA</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">CODIGO</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD>UQ NN</TD></TR><TR><TD ALIGN="LEFT">NOMBRE</TD><TD ALIGN="LEFT">VARCHAR2(100)</TD><TD>NN</TD></TR></TABLE>>];
LUGAR_COMPRA [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>LUGAR_COMPRA</B></TD></TR><TR><TD ALIGN="LEFT">ID_LUGAR</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">CODIGO</TD><TD ALIGN="LEFT">VARCHAR2(5)</TD><TD>UQ NN</TD></TR><TR><TD ALIGN="LEFT">NOMBRE</TD><TD ALIGN="LEFT">VARCHAR2(180)</TD><TD>NN</TD></TR></TABLE>>];
GASTO_DIARIO [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>GASTO_DIARIO</B></TD></TR><TR><TD ALIGN="LEFT">ID_GASTO</TD><TD ALIGN="LEFT">NUMBER(19,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_JORNADA</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">NUMERO_ORDEN</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">DESCRIPCION</TD><TD ALIGN="LEFT">VARCHAR2(180)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">CANTIDAD</TD><TD ALIGN="LEFT">NUMBER(10,2)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ID_UNIDAD</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">TIPO_ITEM</TD><TD ALIGN="LEFT">VARCHAR2(8)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">EQUIVALENCIA_G_CC</TD><TD ALIGN="LEFT">NUMBER(12,2)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ID_FORMA</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">ID_LUGAR</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">VALOR_PAGADO_ESTIMADO</TD><TD ALIGN="LEFT">NUMBER(14,2)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ID_FRECUENCIA</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">TIPO_GASTO</TD><TD ALIGN="LEFT">VARCHAR2(2)</TD><TD>NN</TD></TR></TABLE>>];
COMIDA_FUERA [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>COMIDA_FUERA</B></TD></TR><TR><TD ALIGN="LEFT">ID_COMIDA</TD><TD ALIGN="LEFT">NUMBER(19,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_JORNADA</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">NUMERO_ORDEN</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">DESCRIPCION</TD><TD ALIGN="LEFT">VARCHAR2(180)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">TIPO_COMIDA</TD><TD ALIGN="LEFT">VARCHAR2(20)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">CANTIDAD</TD><TD ALIGN="LEFT">NUMBER(10,2)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ID_FORMA</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">ID_LUGAR</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">VALOR_PAGADO_ESTIMADO</TD><TD ALIGN="LEFT">NUMBER(14,2)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ID_FRECUENCIA</TD><TD ALIGN="LEFT">NUMBER(5,0)</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">TIPO_GASTO</TD><TD ALIGN="LEFT">CHAR(1)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">DOMICILIO</TD><TD ALIGN="LEFT">NUMBER(1,0)</TD><TD>NN</TD></TR></TABLE>>];
CIERRE_CUADERNILLO [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>CIERRE_CUADERNILLO</B></TD></TR><TR><TD ALIGN="LEFT">ID_CIERRE</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK UQ NN</TD></TR><TR><TD ALIGN="LEFT">GASTO_EVENTO_ESPECIAL</TD><TD ALIGN="LEFT">NUMBER(1,0)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">FORMA_PAGO_PRINCIPAL</TD><TD ALIGN="LEFT">VARCHAR2(30)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">OTRA_FORMA_PAGO</TD><TD ALIGN="LEFT">VARCHAR2(80)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">OBSERVACIONES</TD><TD ALIGN="LEFT">VARCHAR2(500)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">ESTADO_REVISION</TD><TD ALIGN="LEFT">VARCHAR2(20)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ID_SUPERVISOR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">FECHA_REVISION</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD></TD></TR></TABLE>>];
REVISION_CRITICA [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>REVISION_CRITICA</B></TD></TR><TR><TD ALIGN="LEFT">ID_REVISION</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_HOGAR</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">ID_CRITICO</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">FECHA_REVISION</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ESTADO</TD><TD ALIGN="LEFT">VARCHAR2(15)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">RESULTADO</TD><TD ALIGN="LEFT">VARCHAR2(500)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">OBSERVACIONES</TD><TD ALIGN="LEFT">VARCHAR2(500)</TD><TD></TD></TR></TABLE>>];
HALLAZGO_CRITICA [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3"><B>HALLAZGO_CRITICA</B></TD></TR><TR><TD ALIGN="LEFT">ID_HALLAZGO</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>PK NN</TD></TR><TR><TD ALIGN="LEFT">ID_REVISION</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK NN</TD></TR><TR><TD ALIGN="LEFT">CAPITULO</TD><TD ALIGN="LEFT">VARCHAR2(3)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">DIA_ENCUESTA</TD><TD ALIGN="LEFT">NUMBER(2,0)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">DESCRIPCION</TD><TD ALIGN="LEFT">VARCHAR2(1000)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ESTADO</TD><TD ALIGN="LEFT">VARCHAR2(15)</TD><TD>NN</TD></TR><TR><TD ALIGN="LEFT">ID_RESPONSABLE</TD><TD ALIGN="LEFT">NUMBER(10,0)</TD><TD>FK</TD></TR><TR><TD ALIGN="LEFT">FECHA_CORRECCION</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD></TD></TR><TR><TD ALIGN="LEFT">FECHA_VERIFICACION</TD><TD ALIGN="LEFT">TIMESTAMP</TD><TD></TD></TR><TR><TD ALIGN="LEFT">OBSERVACION_RESPUESTA</TD><TD ALIGN="LEFT">VARCHAR2(1000)</TD><TD></TD></TR><TR><TD ALIGN="LEFT">HISTORIAL_SUBSANACION</TD><TD ALIGN="LEFT">CLOB</TD><TD>NN</TD></TR></TABLE>>];
ROL -> USUARIO [dir=none,taillabel="1",headlabel="0..*",label="ID_ROL"];
USUARIO -> ASIGNACION_HOGAR [dir=none,taillabel="1",headlabel="0..*",label="ID_USUARIO"];
HOGAR -> ASIGNACION_HOGAR [dir=none,taillabel="1",headlabel="0..*",label="ID_HOGAR"];
HOGAR -> PERIODO_RECOLECCION [dir=none,taillabel="1",headlabel="0..1",label="ID_HOGAR"];
HOGAR -> VISITA [dir=none,taillabel="1",headlabel="0..*",label="ID_HOGAR"];
HOGAR -> CARACTERISTICA_GASTO [dir=none,taillabel="1",headlabel="0..*",label="ID_HOGAR"];
GRUPO_ALIMENTO -> CARACTERISTICA_GASTO [dir=none,taillabel="1",headlabel="0..*",label="ID_GRUPO"];
FRECUENCIA_COMPRA -> CARACTERISTICA_GASTO [dir=none,taillabel="1",headlabel="0..*",label="ID_FRECUENCIA"];
HOGAR -> RESUMEN_MERCADO [dir=none,taillabel="1",headlabel="0..*",label="ID_HOGAR"];
