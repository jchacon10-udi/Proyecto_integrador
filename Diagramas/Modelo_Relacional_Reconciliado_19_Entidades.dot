FORMA_ADQUISICION -> GASTO_DIARIO [dir=none,taillabel="1",headlabel="0..*",label="ID_FORMA"];
LUGAR_COMPRA -> GASTO_DIARIO [dir=none,taillabel="0..1",headlabel="0..*",label="ID_LUGAR"];
FRECUENCIA_COMPRA -> GASTO_DIARIO [dir=none,taillabel="0..1",headlabel="0..*",label="ID_FRECUENCIA"];
JORNADA_DIARIA -> COMIDA_FUERA [dir=none,taillabel="1",headlabel="0..*",label="ID_JORNADA"];
FORMA_ADQUISICION -> COMIDA_FUERA [dir=none,taillabel="1",headlabel="0..*",label="ID_FORMA"];
LUGAR_COMPRA -> COMIDA_FUERA [dir=none,taillabel="0..1",headlabel="0..*",label="ID_LUGAR"];
FRECUENCIA_COMPRA -> COMIDA_FUERA [dir=none,taillabel="0..1",headlabel="0..*",label="ID_FRECUENCIA"];
HOGAR -> CIERRE_CUADERNILLO [dir=none,taillabel="1",headlabel="0..1",label="ID_HOGAR"];
USUARIO -> CIERRE_CUADERNILLO [dir=none,taillabel="0..1",headlabel="0..*",label="ID_SUPERVISOR"];
HOGAR -> REVISION_CRITICA [dir=none,taillabel="1",headlabel="0..*",label="ID_HOGAR"];
USUARIO -> REVISION_CRITICA [dir=none,taillabel="1",headlabel="0..*",label="ID_CRITICO"];
REVISION_CRITICA -> HALLAZGO_CRITICA [dir=none,taillabel="1",headlabel="0..*",label="ID_REVISION"];
USUARIO -> HALLAZGO_CRITICA [dir=none,taillabel="0..1",headlabel="0..*",label="ID_RESPONSABLE"];
}