    FORMA_ADQUISICION ||--o{ GASTO_DIARIO : id_forma
    LUGAR_COMPRA o|--o{ GASTO_DIARIO : id_lugar
    FRECUENCIA_COMPRA o|--o{ GASTO_DIARIO : id_frecuencia
