%% FUENTE RECONSTRUIDA; no DDL original ni esquema ejecutado.
%% NN/NULL en comentarios de atributos; cardinalidades derivadas de FK y UNIQUE.
erDiagram
    ROL {
        NUMBER_5_0 ID_ROL PK "NN"
        VARCHAR2_30 NOMBRE UK "NN"
    }
    USUARIO {
        NUMBER_10_0 ID_USUARIO PK "NN"
        NUMBER_5_0 ID_ROL FK "NN"
        VARCHAR2_100 NOMBRE  "NN"
        VARCHAR2_120 CORREO UK "NN"
        VARCHAR2_255 CLAVE_HASH  "NN"
        VARCHAR2_15 ESTADO  "NN"
    }
    HOGAR {
        NUMBER_10_0 ID_HOGAR PK "NN"
        VARCHAR2_30 CODIGO_OPERATIVO UK "NN"
        VARCHAR2_5 REGION  "NN"
        VARCHAR2_5 DEPARTAMENTO  "NN"
        VARCHAR2_8 MUNICIPIO  "NN"
        VARCHAR2_5 CLASE  "NN"
        VARCHAR2_8 SECTOR  "NULL"
        VARCHAR2_8 SECCION  "NULL"
        VARCHAR2_8 MANZANA  "NULL"
        VARCHAR2_8 SEGMENTO  "NULL"
