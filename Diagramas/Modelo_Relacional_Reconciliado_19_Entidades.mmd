        TIMESTAMP FECHA_VERIFICACION  "NULL"
        VARCHAR2_1000 OBSERVACION_RESPUESTA  "NULL"
        CLOB HISTORIAL_SUBSANACION  "NN"
    }
    ROL ||--o{ USUARIO : id_rol
    USUARIO ||--o{ ASIGNACION_HOGAR : id_usuario
    HOGAR ||--o{ ASIGNACION_HOGAR : id_hogar
