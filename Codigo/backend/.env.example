# Copie este archivo como .env y complete los valores. El archivo .env no se sube al repositorio.
# memoria: datos de prueba en memoria | oracle: esquema ENPH en Oracle
ENPH_MODO=oracle

# Oracle local en Docker (Oracle Free 23ai): modo thin, sin cliente adicional
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USUARIO=ENPH_APP
ORACLE_CLAVE=
ORACLE_ESQUEMA=ENPH

# Servidor de la universidad (Oracle 10g 10.2): exige modo thick con Oracle Instant Client 11.2
# ORACLE_DSN=192.168.254.215:1521/orcl   (o el alias TNS: orcl)
# ORACLE_CLIENTE=C:\oracle\instantclient_11_2
